# Server-only settings. Never use VITE_* for credentials.
ANTHROPIC_API_KEY=
CLAUDE_MANAGED_AGENT_ID=
CLAUDE_MANAGED_ENVIRONMENT_ID=
# Lab 05 live mode only: the custom-tools agent from "managed:provision -- lab05".
CLAUDE_MANAGED_LAB05_AGENT_ID=
CLAUDE_MANAGED_LAB07_AGENT_ID=
CLAUDE_MANAGED_LAB08_AGENT_ID=
# Optional Lab 02 base version pin; omit this setting for latest-version policy.
# MANAGED_AGENT_VERSION=1
# App gate: never enabled by startup, installation, or diagnostics.
MANAGED_LIVE_ENABLED=false
# App limits, validated before live work.
MANAGED_DEADLINE_MS=120000
MANAGED_MAX_CONCURRENT=2
# Model used only by the manual provisioning command; confirm account availability.
MANAGED_MODEL=claude-opus-5-5
# Integer US cents; the platform checks the cap between model requests.
MANAGED_BUDGET_CENTS=50
# Default development API port is 3076. Set in the shell for both processes
# if overriding, because Vite does not read this .env file.
# Optional Lab 13 native MCP: manually reviewed public HTTPS endpoint and existing
# vault with a credential registered for that exact MCP URL. Leave blank for host bridge.
CLAUDE_MANAGED_LAB13_INVENTORY_URL=
CLAUDE_MANAGED_LAB13_VAULT_ID=

# Lab 75 is isolated from the shared key; only deliberate live runs use this key.
LAB75_ANTHROPIC_API_KEY=
LAB75_PLANNER_AGENT_ID=
LAB75_PLANNER_AGENT_VERSION=
LAB75_DEVELOPER_AGENT_ID=
LAB75_DEVELOPER_AGENT_VERSION=
LAB75_REVIEWER_AGENT_ID=
LAB75_REVIEWER_AGENT_VERSION=

# Learning Guide: server-only Inworld Base64 credentials from the portal; do not encode twice.
INWORLD_API_KEY=
INWORLD_NARRATION_ENABLED=0
INWORLD_VOICE_ID=Yash
INWORLD_MODEL_ID=inworld-tts-2

# Lab 65 optional delivery. Leave disabled until a destination is configured.
LAB65_EXTERNAL_NOTIFICATIONS=0
LAB65_SLACK_WEBHOOK_URL=
LAB65_TEAMS_WORKFLOW_URL=
LAB65_GRAPH_SENDER=
LAB65_GRAPH_RECIPIENT=
LAB65_GRAPH_TOKEN=
# Personal Microsoft mailbox: dedicated public client and interactive delegated Mail.Send.
LAB65_GRAPH_CLIENT_ID=
LAB65_GRAPH_AUTH_MODE=
LAB65_GRAPH_TOKEN_EXPIRES_AT=

# Lab 44 explicit export of redacted authored host spans to a chosen collector.
LAB44_REMOTE_EXPORT_ENABLED=0
LAB44_OTLP_ENDPOINT=
LAB44_OTLP_BEARER_TOKEN=
LAB44_AZURE_EXPORT_ENABLED=0
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Lab 45 read-only AWS preflight. Uses a distinct AWS-issued key, never the shared key.
LAB45_AWS_LIVE_ENABLED=0
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=
LAB45_AWS_REGION=
LAB45_AWS_AGENT_ID=
LAB45_AWS_ENVIRONMENT_ID=
