# Server-only settings. Never use VITE_* for credentials.
ANTHROPIC_API_KEY=
CLAUDE_MANAGED_AGENT_ID=
CLAUDE_MANAGED_ENVIRONMENT_ID=
# Lab 05 live mode only: the custom-tools agent from "managed:provision -- lab05".
CLAUDE_MANAGED_LAB05_AGENT_ID=
CLAUDE_MANAGED_LAB07_AGENT_ID=
CLAUDE_MANAGED_LAB08_AGENT_ID=
# Optional Lab 02 base version pin; omit this setting for latest-version policy.
# MANAGED_AGENT_VERSION=1
# App gate: never enabled by startup, installation, or diagnostics.
MANAGED_LIVE_ENABLED=false
# App limits, validated before live work.
MANAGED_DEADLINE_MS=120000
MANAGED_MAX_CONCURRENT=2
# Model used only by the manual provisioning command; confirm account availability.
MANAGED_MODEL=claude-opus-5-5
# Integer US cents; the platform checks the cap between model requests.
MANAGED_BUDGET_CENTS=50
# Default development API port is 3076. Set in the shell for both processes
# if overriding, because Vite does not read this .env file.
