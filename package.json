{
  "name": "claude-managed-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "managed:ready": "node --env-file-if-exists=.env --import tsx scripts/managed-setup.ts ready",
    "managed:verify": "node --env-file-if-exists=.env --import tsx scripts/managed-setup.ts verify",
    "managed:provision": "node --env-file-if-exists=.env --import tsx scripts/managed-setup.ts provision",
    "dev": "concurrently --kill-others --names server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run lab69:extension:build && vite build",
    "lab69:extension:build": "node scripts/build-lab69-extension.mjs",
    "test": "npm run test:offline",
    "test:offline": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:capstone": "node --import tsx --test tests/lab50-capstone-domain.test.ts tests/lab50-capstone-agent.test.ts",
    "test:analysis": "node --import tsx --test tests/lab71-data-analysis-agent.test.ts",
    "test:tutor": "node --import tsx --test tests/ai-tutor.test.ts",
    "capstone:check": "node --env-file-if-exists=.env --import tsx scripts/lab50-setup.ts check",
    "capstone:provision": "node --env-file-if-exists=.env --import tsx scripts/lab50-setup.ts provision",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:ui:lessons": "node scripts/lesson-ui.smoke.mjs",
    "test:dev-server": "node --test scripts/dev-server.test.mjs",
    "scan:distribution": "node scripts/scan-distribution.mjs",
    "prepack": "npm run scan:distribution",
    "test:sse": "node --import tsx --test --test-concurrency=1 tests/sse.test.ts",
    "test:lesson-guides": "node --import tsx --test tests/lesson-guides.test.ts",
    "audit:lesson-guides": "node --import tsx scripts/audit-lesson-guides.ts",
    "skills:check": "node --env-file-if-exists=.env --import tsx scripts/lab11-skills-setup.ts check",
    "skills:upload": "node --env-file-if-exists=.env --import tsx scripts/lab11-skills-setup.ts upload",
    "test:docgen": "node --import tsx --test tests/lab72-document-generation-skills.test.ts",
    "docgen:package": "node scripts/lab72-skill-package.mjs",
    "test:prbot": "node --import tsx --test tests/lab73-pr-reviewer-fixer.test.ts",
    "test:redteam": "node --import tsx --test tests/lab74-prompt-injection-redteam.test.ts",
    "test:team": "node --import tsx --test tests/lab75-autonomous-engineering-team.test.ts tests/lab75-live-team.test.ts",
    "test:ui:live-actions": "node scripts/run-browser-tests.mjs live-actions.spec.ts",
    "test:course": "node --import tsx --test tests/course-coverage.test.ts",
    "package:course": "node scripts/package-course.mjs",
    "team:cleanup": "node --import tsx scripts/lab75-cleanup.ts",
    "team:ready": "node --env-file-if-exists=.env --import tsx scripts/lab75-setup.ts ready",
    "team:provision": "node --env-file-if-exists=.env --import tsx scripts/lab75-setup.ts provision",
    "integrations:ready": "node --env-file-if-exists=.env --import tsx scripts/integration-readiness.ts",
    "notifications:ready": "node --env-file-if-exists=.env --import tsx scripts/lab65-notification-readiness.ts",
    "notifications:signin": "node --env-file-if-exists=.env --import tsx scripts/lab65-mail-signin.ts --interactive-personal-signin",
    "guide:live:test": "node --env-file-if-exists=.env --import tsx scripts/learning-guide-live.ts --execute-authorized-narration-test",
    "milestones:check": "node --import tsx scripts/check-learning-milestones.ts",
    "projects:install": "node scripts/mini-projects.mjs install",
    "projects:check": "node scripts/mini-projects.mjs check",
    "projects:build": "node scripts/mini-projects.mjs build",
    "test:editor:real": "npm run lab69:extension:build && node --import tsx scripts/lab69-real-editor.ts",
    "test:ui:audit": "node scripts/run-browser-tests.mjs course-ui-audit.spec.ts",
    "test:live:evidence": "node --test scripts/live-audit-evidence.test.mjs scripts/configure-github-live.test.mjs",
    "test:live:authorized": "node --env-file-if-exists=.env --import tsx scripts/run-live-audit.mjs --execute-authorized-live-tests",
    "narration:plan": "node --import tsx scripts/record-learning-narration.ts --plan",
    "code:plan": "node --import tsx scripts/record-code-narration.ts --plan",
    "code:record": "node --env-file-if-exists=.env --import tsx scripts/record-code-narration.ts --execute-authorized-code-recording",
    "code:audit": "node --import tsx scripts/audit-code-narration.ts",
    "narration:record": "node --env-file-if-exists=.env --import tsx scripts/record-learning-narration.ts --execute-authorized-narration-recording",
    "narration:check": "node --import tsx scripts/audit-learning-narration.ts",
    "infographics:plan": "node --import tsx scripts/record-infographic-narration.ts --plan",
    "infographics:record": "node --env-file-if-exists=.env --import tsx scripts/record-infographic-narration.ts --execute-authorized-infographic-recording",
    "infographics:check": "node --import tsx scripts/audit-infographic-assets.ts",
    "infographics:publish": "node --import tsx scripts/publish-infographic-batch.ts",
    "prompts:build": "node --import tsx scripts/build-student-prompts.mjs --write",
    "prompts:check": "node --import tsx scripts/build-student-prompts.mjs --check",
    "prompts:package": "node --import tsx scripts/build-student-prompts.mjs --package"
  },
  "dependencies": {
    "@anthropic-ai/aws-sdk": "0.8.0",
    "@anthropic-ai/sdk": "1.3.0",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.46",
    "@azure/msal-node": "7.1.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.140.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
