  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env server.mjs\" \"vite --host 127.0.0.1 --port 5193 --strictPort\"",
