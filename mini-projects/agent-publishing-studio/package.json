    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5",
    "@anthropic-ai/sdk": "1.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.6",
    "vite": "8.3.0"
  }
