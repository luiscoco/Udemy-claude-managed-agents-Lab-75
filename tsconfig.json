{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "server", "shared", "tests", "browser-tests", "scripts/record-infographic-narration.ts", "scripts/audit-infographic-assets.ts", "scripts/record-learning-narration.ts", "scripts/audit-learning-narration.ts", "scripts/managed-setup.ts", "scripts/lab11-skills-setup.ts", "vite.config.ts", "playwright.config.ts"]
}
